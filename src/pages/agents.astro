---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents - Treeline" description="Use AI agents with your Treeline data. Connect Claude, Gemini, OpenClaw, and any MCP client.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="text-3xl font-semibold mb-4">Agents</h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl">
        Your AI agent connects directly to your local Treeline database — sync transactions, auto-tag spending, manage budgets, run queries, and more. All locally, all instantly.
      </p>
    </header>

    <!-- MCP -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-2">MCP server</h2>
      <p class="text-[var(--color-text-muted)] mb-6">
        Treeline includes a local <a href="https://modelcontextprotocol.io" class="text-[var(--color-accent)]" target="_blank" rel="noopener noreferrer">MCP</a> server that works with any compatible client. Your agent gets tools to query transactions, sync accounts, tag spending, check budgets, and more.
      </p>

      <div class="agents-grid">
        <!-- Claude Desktop -->
        <div class="agent-card">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.3041 3.541h-3.6718l6.696 16.918H24zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456z" fill="currentColor"/>
              </svg>
              <h3 class="agent-title">Claude Desktop</h3>
            </div>
          </div>
          <p class="agent-description">
            Chat with your finances in natural language. Tag transactions, create rules, manage budgets, and query anything.
          </p>
          <div class="agent-links">
            <a href="/download#claude-extension" class="agent-link">
              Download extension
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Cursor / Windsurf / VS Code -->
        <div class="agent-card">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="3" fill="currentColor"/>
                <circle cx="4" cy="8" r="2" fill="currentColor" opacity="0.6"/>
                <circle cx="4" cy="16" r="2" fill="currentColor" opacity="0.6"/>
                <circle cx="20" cy="8" r="2" fill="currentColor" opacity="0.6"/>
                <circle cx="20" cy="16" r="2" fill="currentColor" opacity="0.6"/>
                <line x1="9.5" y1="11" x2="5.5" y2="9" stroke="currentColor" stroke-width="1.2" opacity="0.4"/>
                <line x1="9.5" y1="13" x2="5.5" y2="15" stroke="currentColor" stroke-width="1.2" opacity="0.4"/>
                <line x1="14.5" y1="11" x2="18.5" y2="9" stroke="currentColor" stroke-width="1.2" opacity="0.4"/>
                <line x1="14.5" y1="13" x2="18.5" y2="15" stroke="currentColor" stroke-width="1.2" opacity="0.4"/>
              </svg>
              <h3 class="agent-title">Any MCP client</h3>
            </div>
          </div>
          <p class="agent-description">
            Cursor, Windsurf, VS Code, or any other MCP-compatible tool. Point it at <code>tl mcp</code> and go.
          </p>
          <div class="agent-meta">
            <span class="agent-tag">Requires <a href="/download#cli" class="cli-requirement-link">Treeline CLI</a></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <hr class="border-t border-[var(--color-border)] mb-12" />

    <!-- CLI agents -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-2">CLI agents</h2>
      <p class="text-[var(--color-text-muted)] mb-6">
        Agents that talk to Treeline through the command line. <a href="/download#cli" class="text-[var(--color-accent)]">Install the CLI</a> to get started.
      </p>

      <div class="agents-grid">
        <!-- Claude Code -->
        <div class="agent-card">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 6l-6 6 6 6M16 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <h3 class="agent-title">Claude Code</h3>
            </div>
          </div>
          <p class="agent-description">
            Manage your finances from the terminal — sync accounts, tag transactions, set up budgets, and run queries.
          </p>
        </div>

        <!-- Gemini CLI -->
        <div class="agent-card">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C12 7.52 7.52 12 2 12C7.52 12 12 16.48 12 22C12 16.48 16.48 12 22 12C16.48 12 12 7.52 12 2Z" fill="currentColor"/>
              </svg>
              <h3 class="agent-title">Gemini CLI</h3>
            </div>
          </div>
          <p class="agent-description">
            Use Google's Gemini CLI to query your finances, manage transactions, and automate budgeting tasks.
          </p>
        </div>

        <!-- OpenClaw -->
        <div class="agent-card">
          <div class="agent-header">
            <h3 class="agent-title">OpenClaw</h3>
          </div>
          <p class="agent-description">
            Your AI agent syncs transactions, tags spending, and manages budgets — via Discord, WhatsApp, or Telegram.
          </p>
          <div class="agent-links">
            <a
              href="https://clawdhub.com/zack-schrag/treeline-money"
              target="_blank"
              rel="noopener noreferrer"
              class="agent-link"
            >
              Get the Treeline skill
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <hr class="border-t border-[var(--color-border)] mb-12" />

    <!-- Coming Soon -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Coming soon</h2>

      <div class="agents-grid">
        <!-- ChatGPT -->
        <div class="agent-card coming-soon">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071.005l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071-.006l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.661zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" fill="currentColor"/>
              </svg>
              <h3 class="agent-title">ChatGPT</h3>
            </div>
            <span class="coming-soon-badge">Soon</span>
          </div>
          <p class="agent-description">
            Requires a remote MCP server. We're working on it.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .agents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .agent-card {
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
  }

  .agent-card.coming-soon {
    border-style: dashed;
    opacity: 0.7;
  }

  .agent-title-with-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .agent-logo {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .agent-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .agent-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .agent-price {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .agent-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  .agent-meta {
    margin-bottom: 1rem;
  }

  .agent-tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-tertiary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .cli-requirement-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cli-requirement-link:hover {
    opacity: 0.8;
  }

  .agent-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agent-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: opacity 0.15s ease;
  }

  .agent-link:hover {
    opacity: 0.8;
  }

  .agent-link-secondary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .agent-link-secondary:hover {
    color: var(--color-text);
  }

  .coming-soon-badge {
    display: inline-block;
    padding: 0.125rem 0.375rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: 0.625rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
</style>
