---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents - Treeline" description="Use AI agents with your Treeline data.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="text-3xl font-semibold mb-4">Agents</h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl">
        Your data lives on your machine, so AI agents get direct access. No API keys, no rate limits, no latency.
      </p>
    </header>

    <!-- Available -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-2">Available now</h2>
      <p class="text-[var(--color-text-muted)] mb-6">
        Connect your AI agent to Treeline today.
      </p>

      <div class="agents-grid">
        <!-- OpenClaw -->
        <div class="agent-card">
          <div class="agent-header">
            <h3 class="agent-title">OpenClaw</h3>
            <span class="agent-price">Free</span>
          </div>
          <p class="agent-description">
            Chat with your finances via Discord, WhatsApp, or Telegram. Ask "What's my net worth?" and get instant answers.
          </p>
          <div class="agent-meta">
            <span class="agent-tag">Requires <a href="/download#cli" class="cli-requirement-link">Treeline CLI</a></span>
          </div>
          <div class="agent-links">
            <a
              href="https://clawdhub.com/zack-schrag/treeline-money"
              target="_blank"
              rel="noopener noreferrer"
              class="agent-link"
            >
              Get the Treeline skill
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://openclaw.ai"
              target="_blank"
              rel="noopener noreferrer"
              class="agent-link-secondary"
            >
              Learn about OpenClaw
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <hr class="border-t border-[var(--color-border)] mb-12" />

    <!-- Coming Soon -->
    <section>
      <h2 class="text-xl font-semibold mb-2">Coming soon</h2>
      <p class="text-[var(--color-text-muted)] mb-6">
        More ways to connect AI agents to your financial data.
      </p>

      <div class="agents-grid">
        <!-- Claude -->
        <div class="agent-card coming-soon">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.903 2.2c-.455-.243-1.043-.053-1.31.424l-6.39 11.39-2.064-3.68c-.267-.477-.855-.667-1.31-.424-.456.243-.608.831-.341 1.308l2.804 5c.169.3.473.486.808.486h.058c.346-.011.654-.214.814-.527l7.272-12.97c.267-.476.115-1.064-.341-1.308z" fill="currentColor"/>
                <path d="M21.903 11.2c-.455-.243-1.043-.053-1.31.424l-6.39 11.39-2.064-3.68c-.267-.477-.855-.667-1.31-.424-.456.243-.608.831-.341 1.308l2.804 5c.169.3.473.486.808.486h.058c.346-.011.654-.214.814-.527l7.272-12.97c.267-.476.115-1.064-.341-1.308z" fill="currentColor" opacity="0.5"/>
              </svg>
              <h3 class="agent-title">Claude</h3>
            </div>
            <span class="coming-soon-badge">Soon</span>
          </div>
          <p class="agent-description">
            Connect Treeline to Claude via MCP. Ask about your spending, budgets, and net worth in natural language.
          </p>
        </div>

        <!-- ChatGPT -->
        <div class="agent-card coming-soon">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071.005l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071-.006l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.661zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" fill="currentColor"/>
              </svg>
              <h3 class="agent-title">ChatGPT</h3>
            </div>
            <span class="coming-soon-badge">Soon</span>
          </div>
          <p class="agent-description">
            Connect Treeline to ChatGPT via MCP. Query your financial data conversationally.
          </p>
        </div>

        <!-- Claude Code -->
        <div class="agent-card coming-soon">
          <div class="agent-header">
            <div class="agent-title-with-logo">
              <svg class="agent-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 6l-6 6 6 6M16 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <h3 class="agent-title">Claude Code</h3>
            </div>
            <span class="coming-soon-badge">Soon</span>
          </div>
          <p class="agent-description">
            Query and manage your finances from the terminal with Claude Code.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .agents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .agent-card {
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
  }

  .agent-card.coming-soon {
    border-style: dashed;
    opacity: 0.7;
  }

  .agent-title-with-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .agent-logo {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .agent-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .agent-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .agent-price {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .agent-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  .agent-meta {
    margin-bottom: 1rem;
  }

  .agent-tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-tertiary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .cli-requirement-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cli-requirement-link:hover {
    opacity: 0.8;
  }

  .agent-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agent-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: opacity 0.15s ease;
  }

  .agent-link:hover {
    opacity: 0.8;
  }

  .agent-link-secondary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .agent-link-secondary:hover {
    color: var(--color-text);
  }

  .coming-soon-badge {
    display: inline-block;
    padding: 0.125rem 0.375rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: 0.625rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
</style>
