---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pricing - Treeline" description="Treeline is free and open source. No account, no subscription, no paid tier.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold mb-4">Free. That's the whole page.</h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl">
        Treeline is free and open source. No account, no subscription, no paid tier. I built it because I wanted a finance app that worked the way I think, and I want it to exist more than I want to monetize it.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Everything included</h2>
      <p class="text-[var(--color-text-muted)] mb-4 leading-relaxed">
        The desktop app, every plugin, CSV import, SQL access, AI agent integration — all of it. It's <a href="https://github.com/treeline-money/treeline" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">open source</a>, so you can read every line and verify exactly what it does with your data.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">The one real cost: bank data</h2>
      <p class="text-sm text-[var(--color-text-muted)]">
        Want automatic bank sync? Two options, paid directly to the provider — Treeline takes nothing:
      </p>
      <ul class="text-sm text-[var(--color-text-muted)] mt-2 ml-4 list-disc space-y-1">
        <li><a href="https://beta-bridge.simplefin.org/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">SimpleFIN</a> — ~$1.50/month, US & Canada</li>
        <li><a href="https://www.lunchflow.app/?atp=treeline" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Lunch Flow</a> — ~$3/month, global (US, Canada, EU, UK, Brazil, Asia)</li>
      </ul>
      <p class="text-sm text-[var(--color-text-muted)] mt-4">
        Or skip it entirely — CSV import is free and works with any bank.
      </p>
    </section>

    <section class="mb-12">
      <p class="text-[var(--color-text-muted)]">
        Questions? <a href="https://discord.gg/EcNvBnSft5" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Join the Discord</a>.
      </p>
    </section>

    <!-- Final CTA -->
    <section class="mt-16 text-center">
      <a
        href="/download"
        class="inline-block px-5 py-2.5 bg-[var(--color-accent)] text-white font-medium rounded-md hover:bg-[var(--color-accent-muted)] transition-colors"
      >
        Download for free
      </a>
    </section>
  </div>
</BaseLayout>
