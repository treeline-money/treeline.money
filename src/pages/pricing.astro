---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pricing - Treeline" description="Treeline is free. Paid features are in the works — join the waitlist to hear when they ship.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <!-- Hero: paid features up front -->
    <header class="mb-10">
      <h1 class="text-3xl font-semibold mb-4">Paid features, in progress</h1>
      <p class="text-lg text-[var(--color-text-muted)] max-w-2xl">
        Treeline will stay free. I'm exploring some optional paid add-ons to keep the project sustainable. Tell me which you'd use and I'll reach out when they ship.
      </p>
    </header>

    <!-- Feature cards + waitlist CTA (visible together, above the fold) -->
    <section class="mb-16">
      <div class="features-grid mb-10">
        <div class="feature-card">
          <div class="feature-icon">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <h3 class="feature-title">Cloud backup</h3>
          <p class="feature-description">
            Automatic, encrypted backups so you never lose your data.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
          </div>
          <h3 class="feature-title">Multi-device sync</h3>
          <p class="feature-description">
            Same data across desktop, mobile, and AI apps. Picks up where you left off.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3" />
            </svg>
          </div>
          <h3 class="feature-title">Built-in bank sync</h3>
          <p class="feature-description">
            Connect accounts directly in Treeline — no separate SimpleFIN or Lunch Flow signup.
          </p>
        </div>
      </div>

      <div class="waitlist-cta">
        <button
          data-tally-open="681JYe"
          data-tally-layout="modal"
          data-tally-width="600"
          data-tally-emoji-text="👋"
          data-tally-emoji-animation="wave"
          class="waitlist-button"
        >
          Join the waitlist
        </button>
        <p class="discord-alt">
          Prefer to chat? <a href="https://discord.gg/EcNvBnSft5" target="_blank" rel="noopener noreferrer">Join the Discord</a>.
        </p>
      </div>
      <script is:inline src="https://tally.so/widgets/embed.js"></script>
    </section>

    <!-- Divider -->
    <hr class="border-t border-[var(--color-border)] mb-16" />

    <!-- Available today: reassure that the app itself is free -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Available today, free</h2>
      <p class="text-[var(--color-text-muted)] mb-4 leading-relaxed">
        The desktop app, every plugin, CSV import, SQL access — no account, no subscription. I built Treeline because I wanted a finance app that worked the way I think. It's <a href="https://github.com/treeline-money/treeline" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">open source</a>, so you can read every line and verify exactly what it does with your data.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mt-6">
        Want automatic bank sync today? Two options, paid directly to the provider:
      </p>
      <ul class="text-sm text-[var(--color-text-muted)] mt-2 ml-4 list-disc space-y-1">
        <li><a href="https://beta-bridge.simplefin.org/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">SimpleFIN</a> — ~$1.50/month, US & Canada</li>
        <li><a href="https://www.lunchflow.app/?atp=treeline" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Lunch Flow</a> — ~$3/month, global (US, Canada, EU, UK, Brazil, Asia)</li>
      </ul>
    </section>

    <!-- Final CTA -->
    <section class="mt-16 text-center">
      <a
        href="/download"
        class="inline-block px-5 py-2.5 bg-[var(--color-accent)] text-white font-medium rounded-md hover:bg-[var(--color-accent-muted)] transition-colors"
      >
        Download for free
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .feature-card {
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .feature-icon {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .feature-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .waitlist-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    font-weight: 500;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.15s ease;
  }

  .waitlist-button:hover {
    background: var(--color-accent-muted);
  }

  .discord-alt {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .discord-alt a {
    color: var(--color-accent);
  }

  .discord-alt a:hover {
    text-decoration: underline;
  }
</style>
